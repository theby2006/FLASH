VITE_FIREBASE_API_KEY="your-real-api-key"
VITE_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project-id.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef1234567890"

# Development (recommended): leave unset — Vite proxies on localhost;
# phone at http://LAN_IP:5173 auto-connects to http://LAN_IP:5001 (do NOT set localhost here).
# VITE_API_BASE_URL=
# VITE_SOCKET_URL=
VITE_DEV_API_TARGET=http://localhost:5001

# Production: set your deployed API origin
# VITE_API_BASE_URL=https://api.example.com
# VITE_SOCKET_URL=https://api.example.com

# TURN is loaded from the server (GET /api/calls/ice-servers) — no client vars needed.
# Testing on phone: open http://YOUR_LAN_IP:5173 (not localhost) on the phone browser.

# Production build on a separate host from API:
# VITE_API_BASE_URL=http://YOUR_LAN_IP:5001
# VITE_SOCKET_URL=http://YOUR_LAN_IP:5001
