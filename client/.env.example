# From Firebase Console → Project settings → Your apps → Web app (firebaseConfig object)
# NOT the Google OAuth client secret — those are configured inside Firebase for Google sign-in.
VITE_FIREBASE_API_KEY="your-real-api-key"
VITE_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project-id.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef1234567890"

VITE_API_BASE_URL="http://localhost:5001"
VITE_SOCKET_URL="http://localhost:5001"

# Also in Firebase Console:
# 1. Authentication → Sign-in method → Enable Google
# 2. Authentication → Settings → Authorized domains → add localhost
