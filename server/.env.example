# Local Docker: postgresql://postgres:postgres@localhost:5432/flash_db?schema=public
# Neon example: postgresql://user:pass@host/neondb?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/flash_db?schema=public"
PORT=5001
HOST=0.0.0.0

# Comma-separated allowed frontends (phone/tablet on LAN: add http://192.168.x.x:5173)
CLIENT_URL="http://localhost:5173"
# CLIENT_URLS="http://localhost:5173,http://192.168.1.100:5173"

# Firebase Admin — download service account JSON from Firebase Console
FIREBASE_SERVICE_ACCOUNT_PATH="./firebase-service-account.json"
FIREBASE_PROJECT_ID="your-project-id"

# ── WebRTC TURN (required for calls between different devices / networks) ──
# Dev: ENABLE_DEV_TURN uses a public relay automatically (non-production).
ENABLE_DEV_TURN=true

# Production / self-hosted (docker-compose coturn):
# TURN_URL=turn:YOUR_PUBLIC_IP:3478,turns:YOUR_PUBLIC_IP:5349
# TURN_USERNAME=flash
# TURN_CREDENTIAL=flashturn
