# Local Docker: postgresql://postgres:postgres@localhost:5432/flash_db?schema=public
# Neon example: postgresql://user:pass@host/neondb?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/flash_db?schema=public"
PORT=5000
CLIENT_URL="http://localhost:5173"

# Firebase Admin — download service account JSON from Firebase Console
FIREBASE_SERVICE_ACCOUNT_PATH="/absolute/path/to/your-firebase-adminsdk.json"
FIREBASE_PROJECT_ID="your-project-id"
# Or use inline credentials instead of FIREBASE_SERVICE_ACCOUNT_PATH:
# FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxx@your-project-id.iam.gserviceaccount.com"
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
